# Copia este archivo a .env (cp .env.example .env). Solo valores de ejemplo: nunca credenciales reales.

# --- Puertos publicados en tu máquina (cámbialos si ya están ocupados) ---
FRONTEND_PORT=5173
BACKEND_PORT=8000
MAILPIT_PORT=8025
# Por si quieres conectar un cliente de BD.
POSTGRES_PORT=5432

# --- Base de datos (servicio db) ---
POSTGRES_USER=sta
POSTGRES_PASSWORD=sta
POSTGRES_DB=sta

# --- Backend ---
# Conexión síncrona con psycopg 3. "db" es el nombre del servicio en docker compose.
DATABASE_URL=postgresql+psycopg://sta:sta@db:5432/sta
# Base de datos de los tests: se crea sola si no existe y se migra al empezar pytest.
TEST_DATABASE_URL=postgresql+psycopg://sta:sta@db:5432/sta_test

# Secreto para firmar los JWT. Genera uno propio con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-de-desarrollo
# Minutos de inactividad antes de cerrar la sesión (RNF-14).
SESSION_MINUTES_CLIENTE=30
SESSION_MINUTES_STAFF=15
# true en producción (solo HTTPS, RNF-09); false en local porque se usa http.
COOKIE_SECURE=false

# Usuario root que se crea al arrancar si no existe (RF-01).
# La contraseña cumple RNF-08: 8 caracteres o más, con letras y números.
ROOT_USERNAME=root
ROOT_PASSWORD=CambiaEsta123

# Correo saliente (mailpit en desarrollo; bandeja en http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=AVIANCO <no-responder@avianco.test>

# URL pública del frontend, para los enlaces de los correos (usa FRONTEND_PORT).
FRONTEND_URL=http://localhost:5173

# --- Frontend ---
# A dónde reenvía Vite las peticiones /api (dentro de la red de docker compose).
VITE_API_PROXY_TARGET=http://backend:8000
# De dónde lee npm run gen:api el /openapi.json.
OPENAPI_URL=http://backend:8000/openapi.json
# true: el frontend responde la API con los datos de ejemplo de MSW (frontend/src/mocks), para
# avanzar en pantallas cuyo endpoint todavía es un stub (501). Tras cambiarlo:
# docker compose up -d frontend
VITE_API_MOCK=false
